# Copy this file to .env and fill in only the platforms you're actually
# registering. Any platform left blank simply shows as "not configured" —
# the server still starts fine with zero platforms configured.
#
# Where PLATFORM_REDIRECT_URI is required, point it at:
#   <PUBLIC_BASE_URL>/auth/<platform-id>/callback
# and register that exact URL in the platform's developer console.

# Public URL this backend is reachable at once deployed (Render/Railway/Vercel/etc).
# Used to build each platform's redirect_uri. Use http://localhost:3000 for local dev.
PUBLIC_BASE_URL=http://localhost:3000

# Port the server listens on locally.
PORT=3000

# 32-byte hex key used to encrypt stored tokens at rest (AES-256-GCM).
# Leave blank for local dev — a key will be generated into data/.encryption-key
# automatically. For any real deployment, generate one yourself and set it here:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Comma-separated admin API key(s) required (as `x-api-key` header) to call
# anything under /auth/* or /api/*. Generate with the same command as above.
ADMIN_API_KEYS=

# ---- Meta (Facebook Pages + Instagram Business + Marketing API) ----
# Create an app at https://developers.facebook.com/apps
# Needs Business verification + App Review before ads_management/instagram
# scopes work outside your own test accounts.
META_CLIENT_ID=
META_CLIENT_SECRET=

# ---- Google (shared by YouTube, Google Ads, AdSense) ----
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API additionally requires a developer token from
# https://ads.google.com/aw/apicenter (approval can take days/weeks) and the
# target customer account id:
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ---- Reddit ----
# Create an app (type "web app") at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Pinterest ----
# Create an app at https://developers.pinterest.com/apps
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ---- TikTok (Login Kit / Business) ----
# Create an app at https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- X / Twitter (API v2, OAuth2 + PKCE) ----
# Create an app at https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---- LinkedIn ----
# Create an app at https://www.linkedin.com/developers/apps
# Marketing/ads scopes require LinkedIn Marketing Developer Platform approval.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Snapchat (Marketing API) ----
# Create an app at https://businesshelp.snapchat.com (Snapchat Business)
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
